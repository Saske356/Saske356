# Скопируйте этот файл в .env и заполните. Файл .env никому не показывайте!

# Токен от @BotFather
TELEGRAM_TOKEN=

# Ключ OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ваш Telegram id (узнать: команда /id в боте). Через запятую.
# ОБЯЗАТЕЛЬНО заполните — иначе чужие люди потратят ваш баланс.
ALLOWED_USERS=

# Модель чата (дёшево и умно). Любая с https://openrouter.ai/models
CHAT_MODEL=google/gemini-2.5-flash

# Фото: openrouter (Nano Banana, ~$0.04/шт) или pollinations (бесплатно, хуже)
IMAGE_PROVIDER=openrouter
IMAGE_MODEL=google/gemini-nano-banana-2.1

# Видео через OpenRouter. Модель по умолчанию (менять в боте: /vmodel)
VIDEO_MODEL=google/veo-3.1-lite

# Сколько бот может потратить за день, $ (0 = без лимита)
DAILY_LIMIT_USD=1.0

# --- Необязательно: Google Gemini напрямую (в России нужен VPN) ---
# GEMINI_API_KEY=
