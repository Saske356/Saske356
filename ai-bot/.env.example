# Скопируйте этот файл в .env и заполните. Файл .env никому не показывайте!

# Токен от @BotFather
TELEGRAM_TOKEN=

# Бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ваш Telegram id (узнать: команда /id в боте). Через запятую.
# Пусто = ботом может пользоваться кто угодно.
ALLOWED_USERS=

# Модель чата
CHAT_MODEL=gemini-2.5-flash

# Фото: pollinations (бесплатно) или gemini (нужен платный тариф Gemini API)
IMAGE_PROVIDER=pollinations

# Видео (Google Veo) — только платный тариф Gemini API. 1 = включить.
VIDEO_ENABLED=0
VIDEO_MODEL=veo-3.0-generate-001
