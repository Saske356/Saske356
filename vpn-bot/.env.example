# Скопируй этот файл в .env и заполни. Файл .env никому не отправляй.
BOT_TOKEN=токен_от_BotFather
ADMIN_IDS=123456789
BRAND=Aurora VPN
TAGLINE=Приватный доступ к свободному интернету
SUPPORT_USERNAME=твой_ник_поддержки
TRIAL_DAYS=1
REF_BONUS_DAYS=3
# 1 — бонус сразу, как друг запустил бота; 0 — только после первой оплаты друга
REF_ON_JOIN=1
REFUND_DAYS=3
# Адрес мини-приложения (GitHub Pages), например https://ник.github.io/репозиторий/
MINIAPP_URL=
# Автопродление тарифа на месяц через подписки Telegram Stars: 1 — включено, 0 — выключено
AUTO_RENEW=1
# Авто-страны: бот сам берёт бесплатные публичные прокси, добавляет из них страны
# и меняет прокси, когда он перестаёт отвечать. 1 — включено, 0 — выключено.
# Публичные прокси медленные и живут недолго: это дополнение к купленным, а не замена.
# Значения ниже читаются только при первом запуске, дальше настройка идёт командой /autoproxy.
AUTO_PROXY=0
# Какие страны держать: коды через запятую, например nl,de,us. Пусто — бот подберёт сам.
AUTO_PROXY_COUNTRIES=
# Сколько стран держать, когда бот подбирает их сам
AUTO_PROXY_MAX=8
# Порт ретранслятора авто-стран на 127.0.0.1. Менять, только если порт занят.
AUTO_RELAY_PORT=20808
# Новостной канал для бонуса за подписку (бот должен быть админом канала). Пусто — без бонуса.
CHANNEL=
CHANNEL_BONUS_DAYS=1
# Раз в сутки присылать админам резервную копию базы: 1 — да, 0 — нет
BACKUP_DAILY=1
# Запасное подключение VLESS XHTTP на том же порту 443: 1 — включено, 0 — выключено
XHTTP=1
# Свой адрес раздачи подписок, например https://sub.example.com (домен за Cloudflare).
# Пусто — http://IP_сервера:порт_подписки
SUB_URL=
# Порт входа для мостов, которые проходят белые списки (мост пересылает на него свой 443)
BRIDGE_PORT=8444
# Порт API Xray на 127.0.0.1: через него клиенты добавляются без перезапуска
XRAY_API_PORT=10085
# Hysteria2: эти строки установщик дописывает сам вместе с сертификатом в /etc/aurora.
# Пусто — Hysteria не установлена и в подписке не показывается.
# HY2_PORT=443
# HY2_OBFS_PORT=8443
# HY2_SNI=www.nvidia.com
# HY2_PIN=отпечаток_сертификата
# HY2_OBFS=пароль_обфускации
# HY2_AUTH_PORT=20809
# HY2_STATS_PORTS=20810,20811
# HY2_STATS_SECRET=секрет
# 0 — Xray не используется, VPN только через Hysteria; 1 — Xray и Hysteria вместе
XRAY_ENABLED=0
# Подписка по HTTPS: https://SUB_DOMAIN/ТОКЕН. Установщик сам получает сертификат Let's Encrypt.
SUB_DOMAIN=
# SUB_CERT=/etc/letsencrypt/live/домен/fullchain.pem
# SUB_KEY=/etc/letsencrypt/live/домен/privkey.pem
# SUB_TLS_PORT=443
# Пароль резервных копий: с ним копия шифруется (AES-256) и приходит одним архивом.
# Без пароля в Telegram приходят обычные файлы. Пароль храни отдельно от копий.
BACKUP_PASSWORD=
# Копия ещё и в облако через rclone, например yadisk:aurora. Сначала на сервере: rclone config
BACKUP_RCLONE=
# Сколько последних копий хранить на сервере и в облаке
BACKUP_KEEP=7
# Лимит устройств: block — предупредить, потом отключить на DEVICE_BLOCK_MINUTES;
# warn — только предупреждать; off — не проверять
DEVICE_LIMIT=block
DEVICE_BLOCK_MINUTES=30
# Возврат ушедших: через сколько дней после окончания подписки и какая скидка (дни:процент).
# Пусто — не предлагать. Скидка действует OFFER_HOURS часов и только на разовую оплату.
WINBACK=3:20,7:30
OFFER_HOURS=72
# Пробный период: за сколько часов до конца напомнить и скидка на первую покупку после него (0 — без)
TRIAL_REMIND_HOURS=3
TRIAL_OFFER=15
# Вторая Hysteria с обфускацией (порт HY2_OBFS_PORT). По умолчанию выключена: в подписке одна
# Hysteria. 1 — включить, затем запустить установщик ещё раз.
HY2_OBFS_ON=0
# UDP-порты серверов Hysteria для стран через прокси (по одному на страну). 0 — только основная страна.
HY2_LOC_PORTS=30000-30049
# Как часто менять сайт маскировки Hysteria, часов. 0 — не менять. Сообщения только админам.
HY2_SNI_EVERY=24
