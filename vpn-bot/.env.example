# Скопируй этот файл в .env и заполни. Файл .env никому не отправляй.
BOT_TOKEN=токен_от_BotFather
ADMIN_IDS=123456789
BRAND=Aurora VPN
TAGLINE=Приватный доступ к свободному интернету
SUPPORT_USERNAME=твой_ник_поддержки
TRIAL_DAYS=1
REF_BONUS_DAYS=3
# 1 — бонус сразу, как друг запустил бота; 0 — только после первой оплаты друга
REF_ON_JOIN=1
REFUND_DAYS=3
# Адрес мини-приложения (GitHub Pages), например https://ник.github.io/репозиторий/
MINIAPP_URL=
# Автопродление тарифа на месяц через подписки Telegram Stars: 1 — включено, 0 — выключено
AUTO_RENEW=1
# Авто-страны: бот сам берёт бесплатные публичные прокси, добавляет из них страны
# и меняет прокси, когда он перестаёт отвечать. 1 — включено, 0 — выключено.
# Публичные прокси медленные и живут недолго: это дополнение к купленным, а не замена.
# Значения ниже читаются только при первом запуске, дальше настройка идёт командой /autoproxy.
AUTO_PROXY=0
# Какие страны держать: коды через запятую, например nl,de,us. Пусто — бот подберёт сам.
AUTO_PROXY_COUNTRIES=
# Сколько стран держать, когда бот подбирает их сам
AUTO_PROXY_MAX=8
# Порт ретранслятора авто-стран на 127.0.0.1. Менять, только если порт занят.
AUTO_RELAY_PORT=20808
# Новостной канал для бонуса за подписку (бот должен быть админом канала). Пусто — без бонуса.
CHANNEL=
CHANNEL_BONUS_DAYS=1
# Раз в сутки присылать админам резервную копию базы: 1 — да, 0 — нет
BACKUP_DAILY=1
# Пароль резервных копий: с ним копия шифруется (AES-256) и приходит одним архивом.
# Без пароля в Telegram приходят два обычных файла. Пароль храни отдельно от копий.
BACKUP_PASSWORD=
# Копия ещё и в облако через rclone, например yadisk:aurora или gdrive:backups.
# Сначала на сервере: rclone config (настроить хранилище один раз). Пусто — только Telegram и диск.
BACKUP_RCLONE=
# Сколько последних копий хранить на сервере и в облаке
BACKUP_KEEP=7
# Лимит устройств: block — предупредить, потом отключить на DEVICE_BLOCK_MINUTES;
# warn — только предупреждать; off — не проверять
DEVICE_LIMIT=block
DEVICE_BLOCK_MINUTES=30
# Возврат ушедших: через сколько дней после окончания подписки и какая скидка (дни:процент).
# Пусто — не предлагать. Скидка действует OFFER_HOURS часов и только на разовую оплату.
WINBACK=3:20,7:30
OFFER_HOURS=72
# Пробный период: за сколько часов до конца напомнить и скидка на первую покупку после него (0 — без)
TRIAL_REMIND_HOURS=3
TRIAL_OFFER=15
# Порт API Xray на 127.0.0.1: через него ключи выдаются без перезапуска. 0 — по-старому, с перезапуском.
XRAY_API_PORT=10085
# Hysteria2 (быстрый режим по UDP). Установщик заполняет HY2_* сам. HY2=0 — выключить.
# HY2_OBFS_PASSWORD — маскировка пакетов под случайные данные (salamander): включай, если
# оператор режет QUIC. После изменения запусти установщик ещё раз, чтобы обновить сервер.
HY2_OBFS_PASSWORD=
# Hysteria2 первым в подписке: приложение по умолчанию берёт его (1). 0 — сначала Reality.
HY2_FIRST=1
# UDP-порты серверов Hysteria2 для других стран (по одному на страну). 0 — Hysteria2 только у основной.
HY2_EXTRA_PORTS=30000-30049
# Порт VLESS XHTTP (TCP): запасной способ, если оператор замораживает обычный Reality. 0 — выключить.
XRAY_XHTTP_PORT=8443
# Подписка по HTTPS. Установщик сам получает сертификат на имя вида 1-2-3-4.sslip.io и вписывает это сюда.
# Пусто — подписка по HTTP (ключи видны по дороге).
SUB_DOMAIN=
SUB_TLS_PORT=2097
SUB_TLS_CERT=
SUB_TLS_KEY=
# Бесплатный прокси медленнее этого (мс на проверочный запрос) не берётся
AUTO_PROXY_MAX_MS=1500
