# Скопируй этот файл в .env и заполни. Файл .env никому не отправляй.
BOT_TOKEN=токен_от_BotFather
ADMIN_IDS=123456789
BRAND=Aurora VPN
TAGLINE=Приватный доступ к свободному интернету
SUPPORT_USERNAME=твой_ник_поддержки
TRIAL_DAYS=1
REF_BONUS_DAYS=3
# 1 — бонус сразу, как друг запустил бота; 0 — только после первой оплаты друга
REF_ON_JOIN=1
REFUND_DAYS=3
# Адрес мини-приложения (GitHub Pages), например https://ник.github.io/репозиторий/
MINIAPP_URL=
# Автопродление тарифа на месяц через подписки Telegram Stars: 1 — включено, 0 — выключено
AUTO_RENEW=1
# Авто-прокси: бот сам берёт бесплатные публичные прокси и добавляет из них страны,
# а при отвале прокси меняет его на живой. 1 — включено, 0 — выключено.
# ⚠️ Публичные прокси нестабильны и небезопасны — это бесплатный запасной вариант,
# а не замена платным прокси страны. Управление в боте: /autoproxy
AUTO_PROXY=0
# Какие страны держать (ISO-коды через запятую, например nl,de,us). Пусто — бот подберёт сам.
AUTO_PROXY_COUNTRIES=
# Сколько стран держать в режиме подбора (когда AUTO_PROXY_COUNTRIES пусто)
AUTO_PROXY_MAX=8
# Новостной канал для бонуса за подписку (бот должен быть админом канала). Пусто — без бонуса.
CHANNEL=
CHANNEL_BONUS_DAYS=1
