# Скопируй этот файл в .env и заполни. Файл .env никому не отправляй.
BOT_TOKEN=токен_от_BotFather
ADMIN_IDS=123456789
BRAND=Aurora VPN
TAGLINE=Приватный доступ к свободному интернету
SUPPORT_USERNAME=твой_ник_поддержки
TRIAL_DAYS=1
REF_BONUS_DAYS=3
# 1 — бонус сразу, как друг запустил бота; 0 — только после первой оплаты друга
REF_ON_JOIN=1
REFUND_DAYS=3
# Адрес мини-приложения (GitHub Pages), например https://ник.github.io/репозиторий/
MINIAPP_URL=
# Автопродление тарифа на месяц через подписки Telegram Stars: 1 — включено, 0 — выключено
AUTO_RENEW=1
# Авто-страны: бот сам берёт бесплатные публичные прокси, добавляет из них страны
# и меняет прокси, когда он перестаёт отвечать. 1 — включено, 0 — выключено.
# Публичные прокси медленные и живут недолго: это дополнение к купленным, а не замена.
# Значения ниже читаются только при первом запуске, дальше настройка идёт командой /autoproxy.
AUTO_PROXY=0
# Какие страны держать: коды через запятую, например nl,de,us. Пусто — бот подберёт сам.
AUTO_PROXY_COUNTRIES=
# Сколько стран держать, когда бот подбирает их сам
AUTO_PROXY_MAX=8
# Порт ретранслятора авто-стран на 127.0.0.1. Менять, только если порт занят.
AUTO_RELAY_PORT=20808
# Новостной канал для бонуса за подписку (бот должен быть админом канала). Пусто — без бонуса.
CHANNEL=
CHANNEL_BONUS_DAYS=1
# Раз в сутки присылать админам резервную копию базы: 1 — да, 0 — нет
BACKUP_DAILY=1
