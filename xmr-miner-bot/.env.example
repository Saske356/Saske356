# Токен бота от @BotFather
BOT_TOKEN=
# Ваш Telegram id (узнать у @userinfobot). Управлять майнером сможет только он.
ADMIN_ID=
# Адрес вашего Monero-кошелька (начинается с 4…). Кошелёк: Cake Wallet, Feather, официальный GUI.
WALLET=
# Пул. По умолчанию SupportXMR, минимальная выплата 0.1 XMR.
POOL=pool.supportxmr.com:443
POOL_TLS=1
# Имя этого компьютера в статистике пула
WORKER=bot
# Сколько процентов потоков процессора отдавать майнеру (1–100)
CPU_PERCENT=50
# Путь к XMRig (ставится скриптом install_xmrig.sh)
XMRIG_PATH=./xmrig/xmrig
