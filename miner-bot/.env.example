# Токен от @BotFather. Никогда не коммитьте настоящий токен.
BOT_TOKEN=
# Ваш Telegram ID (бот покажет его в ответ на любую команду). Несколько — через запятую.
ADMIN_IDS=

# cgminer и пул
CGMINER_PATH=/usr/local/bin/cgminer
POOL_URL=stratum+tcp://pool.example.com:3333
POOL_USER=yourworker.1
POOL_PASS=x
# Доп. ключи cgminer, например для конкретного ASIC
CGMINER_EXTRA=

# API cgminer (только localhost)
CGMINER_API_HOST=127.0.0.1
CGMINER_API_PORT=4028
# 1 — останавливать cgminer, когда бот выключается
STOP_ON_EXIT=1
