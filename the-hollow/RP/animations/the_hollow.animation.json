{
  "format_version": "1.8.0",
  "animations": {
    "animation.the_hollow.walk": {
      "loop": true,
      "bones": {
        "left_leg": {
          "rotation": [
            "math.cos(query.anim_time * 240) * 28 * query.modified_move_speed",
            0,
            0
          ]
        },
        "right_leg": {
          "rotation": [
            "-math.cos(query.anim_time * 240) * 28 * query.modified_move_speed",
            0,
            0
          ]
        },
        "left_arm": {
          "rotation": [
            "-math.cos(query.anim_time * 240) * 12 * query.modified_move_speed",
            0,
            -4
          ]
        },
        "right_arm": {
          "rotation": [
            "math.cos(query.anim_time * 240) * 12 * query.modified_move_speed",
            0,
            4
          ]
        }
      }
    },
    "animation.the_hollow.look": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": [
            "query.target_x_rotation",
            "query.target_y_rotation",
            0
          ]
        }
      }
    },
    "animation.the_hollow.idle": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [
            "12 + math.sin(query.life_time * 60) * 1.5",
            0,
            0
          ]
        },
        "head": {
          "rotation": [
            "-8",
            0,
            "math.sin(query.life_time * 23) * 5"
          ]
        }
      }
    }
  }
}
