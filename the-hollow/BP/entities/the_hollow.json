{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "hollow:the_hollow",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "hollow:idle": {
        "minecraft:movement": { "value": 0 },
        "minecraft:behavior.random_look_around": { "priority": 5 }
      },
      "hollow:watch": {
        "minecraft:movement": { "value": 0 },
        "minecraft:behavior.look_at_player": {
          "priority": 1,
          "look_distance": 96,
          "probability": 1.0,
          "look_time": [600, 600],
          "angle_of_view_horizontal": 360,
          "angle_of_view_vertical": 360
        }
      },
      "hollow:stalk": {
        "minecraft:movement": { "value": 0.31 },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,
          "must_see": false,
          "reselect_targets": true,
          "within_radius": 96,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "player" },
              "max_dist": 96
            }
          ]
        },
        "minecraft:behavior.melee_attack": {
          "priority": 2,
          "speed_multiplier": 0.38,
          "track_target": true,
          "require_complete_path": false
        }
      },
      "hollow:chase": {
        "minecraft:movement": { "value": 0.31 },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,
          "must_see": false,
          "reselect_targets": true,
          "within_radius": 96,
          "entity_types": [
            {
              "filters": { "test": "is_family", "subject": "other", "value": "player" },
              "max_dist": 96
            }
          ]
        },
        "minecraft:behavior.melee_attack": {
          "priority": 2,
          "speed_multiplier": 1.0,
          "track_target": true,
          "require_complete_path": false
        }
      }
    },
    "components": {
      "minecraft:type_family": { "family": ["hollow", "monster", "mob"] },
      "minecraft:health": { "value": 150, "max": 150 },
      "minecraft:attack": { "damage": 12 },
      "minecraft:collision_box": { "width": 0.9, "height": 3.6 },
      "minecraft:physics": {},
      "minecraft:pushable": { "is_pushable": false, "is_pushable_by_piston": true },
      "minecraft:knockback_resistance": { "value": 1.0 },
      "minecraft:follow_range": { "value": 96, "max": 96 },
      "minecraft:fire_immune": {},
      "minecraft:breathable": { "total_supply": 15, "suffocate_time": 0, "breathes_water": true, "breathes_air": true },
      "minecraft:damage_sensor": {
        "triggers": [
          { "cause": "fall", "deals_damage": false },
          { "cause": "suffocation", "deals_damage": false },
          { "cause": "drowning", "deals_damage": false }
        ]
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "can_open_doors": true,
        "can_pass_doors": true
      },
      "minecraft:annotation.open_door": {},
      "minecraft:experience_reward": { "on_death": "50" },
      "minecraft:nameable": {}
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": ["hollow:idle"] }
      },
      "hollow:set_idle": {
        "remove": { "component_groups": ["hollow:watch", "hollow:stalk", "hollow:chase"] },
        "add": { "component_groups": ["hollow:idle"] }
      },
      "hollow:set_watch": {
        "remove": { "component_groups": ["hollow:idle", "hollow:stalk", "hollow:chase"] },
        "add": { "component_groups": ["hollow:watch"] }
      },
      "hollow:set_stalk": {
        "remove": { "component_groups": ["hollow:idle", "hollow:watch", "hollow:chase"] },
        "add": { "component_groups": ["hollow:stalk"] }
      },
      "hollow:set_chase": {
        "remove": { "component_groups": ["hollow:idle", "hollow:watch", "hollow:stalk"] },
        "add": { "component_groups": ["hollow:chase"] }
      }
    }
  }
}
